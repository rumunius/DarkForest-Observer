{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "darkforest-core-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "APP_ENV": "local", "MATCH_ID": "local-rehearsal" },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_DO", "class_name": "DarkForestMatch" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DarkForestMatch"] }],
  "env": {
    "preview": {
      "name": "darkforest-core-preview",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "APP_ENV": "preview", "MATCH_ID": "preview-rehearsal" },
      "durable_objects": {
        "bindings": [{ "name": "MATCH_DO", "class_name": "DarkForestMatch" }],
      },
    },
  },
}
