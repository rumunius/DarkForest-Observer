{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "darkforest-pages-dev",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
  "vars": {
    "APP_ENV": "local",
    "MATCH_ID": "local-rehearsal",
    "TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:8788,http://127.0.0.1:8788",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_DO",
        "class_name": "DarkForestMatch",
        "script_name": "darkforest-core-local",
      },
    ],
  },
  "env": {
    "preview": {
      "vars": {
        "APP_ENV": "preview",
        "MATCH_ID": "preview-rehearsal",
        "TRUSTED_ORIGINS": "https://dev.darkforest-pages-dev.pages.dev",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "MATCH_DO",
            "class_name": "DarkForestMatch",
            "script_name": "darkforest-core-preview",
          },
        ],
      },
    },
  },
}
