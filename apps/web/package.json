{
  "name": "@darkforest/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:pages": "wrangler pages dev --ip 127.0.0.1 --port 8788 --persist-to ../../.wrangler/state",
    "build": "vite build",
    "cf:types": "node ../../scripts/prepare_types.mjs && wrangler types .wrangler/types/env.d.ts --include-runtime false --env-interface PagesEnv",
    "typecheck": "tsc --project tsconfig.app.json && tsc --project tsconfig.functions.json",
    "create:preview": "wrangler pages project create darkforest-pages-dev --production-branch main --force",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name darkforest-pages-dev --branch dev --commit-dirty=true --force"
  },
  "dependencies": {
    "@darkforest/contracts": "*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
